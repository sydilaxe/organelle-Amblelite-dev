#X obj 20 44 expr abs(alenew - alpe[alesl]) > 0.002 \; alenew = (max(0 \, min(1 \, alp[alesl] + alem[alesl] + alfm[alesl] + alfn[alesl] + alfb[alesl]))) \; alem[alesl] = (aled*alew[(alel*5 + aleng[alel])*6 + alek]*0.5*(0.65*sin(6.28319*(alet2/(alep*(1 + 0.37*alek + 0.11*alel)) + 0.31*alek + 0.17*alel)) + 0.35*sin(6.28319*(alet2/(alep*1.618*(1 + 0.37*alek + 0.11*alel)) + 0.7*alek)))) \; alesl = (alet[(alel*5 + aleng[alel])*6 + alek]);
